ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5
REDIS_URL=redis://localhost:6379/0
# SEC requires a real contact in the User-Agent: "AppName your@email.com"
SEC_USER_AGENT=FinanceAgent your-email@example.com
QUOTE_PROVIDER=yahoo

# Observability: LangSmith traces of every conversation turn (grouped by conversation in the Threads view)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=finance-advisor-agent-local
APP_ENV=local
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com   # only for EU-region accounts
